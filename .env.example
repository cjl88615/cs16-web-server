# REQUIRED: replace this EXAMPLE with the VM's bridged LAN IPv4 address.
# Do not use 127.0.0.1. All players must be able to reach this address directly.
LAN_IP=192.168.2.80
WEB_PORT=27016
PORT=27018
SERVER_NAME=Taliabu CS 1.6
START_MAP=de_dust2
MAX_PLAYERS=16
# Total target population (humans + bots), NOT a fixed number of bots.
# Allowed: 0 through MAX_PLAYERS-1, reserving a human join slot.
BOT_QUOTA=8
# 0 beginner, 1 casual, 2 normal, 3 hard, 4 expert.
BOT_DIFFICULTY=2
